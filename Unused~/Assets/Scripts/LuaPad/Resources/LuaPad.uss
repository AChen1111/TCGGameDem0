.launcher {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: 110px;
    height: 40px;
}

.open-button {
    flex-grow: 1;
    background-color: rgb(0, 122, 204);
    color: rgb(255, 255, 255);
    font-size: 16px;
}

.dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    padding: 48px;
}

.panel {
    flex-grow: 1;
    background-color: rgb(30, 30, 30);
    padding: 10px;
    overflow: visible;
}

.header {
    flex-direction: row;
    align-items: center;
    height: 40px;
    margin-bottom: 8px;
}

.title {
    flex-grow: 1;
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.run-button {
    width: 88px;
    height: 32px;
    margin-right: 8px;
    background-color: rgb(0, 122, 204);
    color: rgb(255, 255, 255);
    font-size: 16px;
}

.close-button {
    width: 88px;
    height: 32px;
    background-color: rgb(64, 64, 64);
    color: rgb(255, 255, 255);
    font-size: 16px;
}

.editor-host {
    flex-grow: 1;
    min-height: 200px;
    background-color: rgb(30, 30, 30);
    margin-bottom: 8px;
    overflow: visible;
}

.code-input {
    flex-grow: 1;
    min-height: 200px;
    font-size: 20px;
    color: rgb(212, 212, 212);
}

.code-input .unity-base-text-field__input,
.code-input .unity-text-field__input,
.code-input .unity-text-element {
    flex-grow: 1;
    background-color: rgb(30, 30, 30);
    color: rgb(212, 212, 212);
    font-size: 20px;
    white-space: pre;
}

.completion-list {
    position: absolute;
    left: 16px;
    bottom: 176px;
    width: 320px;
    height: 200px;
    background-color: rgb(37, 37, 38);
    border-width: 1px;
    border-color: rgb(62, 62, 66);
    display: none;
}

.output-scroll {
    height: 160px;
    background-color: rgb(20, 20, 20);
    padding: 8px;
}

.output-label {
    white-space: pre-wrap;
    color: rgb(212, 212, 212);
    font-size: 16px;
}
